-- Adds a department field to User accounts.
-- Safe to run on an existing database (checks before altering).
-- Run this against the campus_marketplace database, e.g.:
--   mysql -u <user> -p campus_marketplace < add_user_department.sql

USE `campus_marketplace`;

SET @column_exists = (
  SELECT COUNT(*)
  FROM information_schema.COLUMNS
  WHERE TABLE_SCHEMA = DATABASE()
    AND TABLE_NAME = 'User'
    AND COLUMN_NAME = 'department'
);

SET @ddl := IF(
  @column_exists = 0,
  'ALTER TABLE `User` ADD COLUMN `department` VARCHAR(100) NOT NULL DEFAULT ''No Department'' AFTER `account_status`',
  'SELECT 1'
);

PREPARE stmt FROM @ddl;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;